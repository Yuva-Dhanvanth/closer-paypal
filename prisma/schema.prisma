generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Seller {
  id                  String         @id @default(cuid())
  slug                String         @unique
  name                String
  tagline             String
  tone                String
  catalog             String         // JSON stringified SellerCatalog
  policies            String         // JSON stringified SellerPolicies
  demoClockOffsetDays Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  conversations       Conversation[]
  agentEvents         AgentEvent[]
  orders              Order[]
}

model Conversation {
  id            String       @id @default(cuid())
  sellerId      String
  customerName  String?
  customerEmail String?
  status        String       @default("active") // active | completed | cancelled
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  seller        Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  messages      Message[]
  quotes        Quote[]
  orders        Order[]
  escalations   Escalation[]
  agentEvents   AgentEvent[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // user | assistant | system_event
  content        String       // JSON stringified payload or text string
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Quote {
  id              String       @id @default(cuid())
  conversationId  String
  sellerId        String
  lines           String       // JSON stringified PricedQuoteLine[]
  subtotalCents   Int
  discountPercent Int          @default(0)
  discountCents   Int          @default(0)
  rushFeeCents    Int          @default(0)
  totalCents      Int
  depositCents    Int
  balanceCents    Int
  dueDate         String
  status          String       @default("draft") // draft | accepted | superseded | expired
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  orders          Order[]
}

model Order {
  id            String       @id @default(cuid())
  sellerId      String
  conversationId String
  quoteId       String
  customerName  String
  customerEmail String
  status        String       @default("deposit_pending") 
  // status: deposit_pending | deposit_paid | balance_requested | paid_in_full | cancelled | refunded
  dueDate       String
  totalCents    Int
  paidCents     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  seller        Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  quote         Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  payments      Payment[]
  escalations   Escalation[]
  agentEvents   AgentEvent[]
}

model Payment {
  id              String    @id @default(cuid())
  sellerId        String
  orderId         String
  type            String    // deposit | balance | refund
  amountCents     Int
  status          String    // pending | completed | failed | refunded
  attempt         Int       @default(1)
  paypalOrderId   String?
  paypalCaptureId String?
  paypalRefundId  String?
  raw             String?   // JSON stringified raw gateway response
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Escalation {
  id             String       @id @default(cuid())
  sellerId       String
  conversationId String
  orderId        String?
  kind           String       // refund_exception | allergy_health | out_of_catalog | complaint | double_reject
  summary        String
  status         String       @default("open") // open | approved | denied
  decidedAmount  Int?         // in cents if approved with custom refund
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model AgentEvent {
  id             String       @id @default(cuid())
  sellerId       String
  conversationId String?
  orderId        String?
  type           String       // tool_call | guardrail | payment_created | payment_captured | refund_issued | escalation | followup
  summary        String
  payload        String?      // JSON stringified details
  createdAt      DateTime     @default(now())

  seller         Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model WebhookEvent {
  id          String   @id // PayPal event ID (e.g. WH-...)
  type        String   // PAYMENT.CAPTURE.COMPLETED, etc.
  verified    Boolean  @default(true)
  payload     String   // JSON stringified webhook payload
  processedAt DateTime @default(now())
}
